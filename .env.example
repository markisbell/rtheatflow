# rtheatflow configuration — pydantic-settings, prefix RTHEATFLOW_, all optional
# (defaults shown; see SPEC.md §6)

# --- paths ---
#RTHEATFLOW_DATA_DIR=./data
# network loaded at startup: <data_dir>/networks/<id> (M4 adds the catalog)
#RTHEATFLOW_DEFAULT_NETWORK=demo_dorf
#RTHEATFLOW_NETWORK_LIBRARY=./data/network_library.json
#RTHEATFLOW_USER_NETWORKS_DIR=./data/user_networks
#RTHEATFLOW_PROFILES_DIR=./data/profiles
#RTHEATFLOW_SCENARIOS_DIR=./data/scenarios
#RTHEATFLOW_RECORDINGS_DIR=./data/recordings

# --- engine ---
# real seconds per simulated minute (0.01 .. n)
#RTHEATFLOW_STEP_INTERVAL_SECONDS=1.0
#RTHEATFLOW_STEPS_PER_DAY=1440
#RTHEATFLOW_AUTOSTART=true
#RTHEATFLOW_HISTORY_SIZE=1440

# --- solver (SPEC §3.3) ---
# base iter for retry-ladder tiers 1/2/4; tier 3 uses 2x
#RTHEATFLOW_SOLVER_ITER=100
# experimental thermal-inertia mode, offline exporter only (SPEC §3.5)
#RTHEATFLOW_TRANSIENT=false

# --- domain defaults ---
# pump electrical efficiency for P_el = P_hyd / eta
#RTHEATFLOW_PUMP_ETA=0.7
# minimum differential pressure at the critical consumer [bar]
#RTHEATFLOW_DP_MIN_BAR=0.5
# amber threshold for return-temperature violations [K]
#RTHEATFLOW_RETURN_TEMP_MARGIN_K=5
# zero-flow guard (SPEC §3.2): consumer qext_w floor [W] — zero-flow branches
# are singular; near-zero temperature-controlled loads diverge (validated M1)
#RTHEATFLOW_MIN_QEXT_W=500

# --- observability ---
# false = strict mode: ground-truth layer stripped from API/WS/recordings
#RTHEATFLOW_EXPOSE_GROUND_TRUTH=true

# --- server ---
#RTHEATFLOW_HOST=127.0.0.1
#RTHEATFLOW_PORT=8000
#RTHEATFLOW_LOG_LEVEL=info
#RTHEATFLOW_CORS_ORIGINS=*
#RTHEATFLOW_RECORD=false
